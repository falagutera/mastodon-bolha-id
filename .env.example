# Where this provider is served, always https, no path. It is the "iss" of every token.
ID_ISSUER=https://id.example.social

# The Mastodon instance. Only its local accounts can sign in.
ID_INSTANCE=https://example.social

# OAuth application on the instance (scope "profile"), see README.md.
ID_MASTODON_CLIENT_ID=
ID_MASTODON_CLIENT_SECRET=

# Token of a service account with the admin:read:accounts scope, see README.md.
ID_MASTODON_ADMIN_TOKEN=

# RSA private key in PEM (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072).
# Either the PEM itself or a file path with the _FILE suffix.
#ID_SIGNING_KEY=
ID_SIGNING_KEY_FILE=/run/secrets/signing-key.pem
# The key before the last rotation, still published in the JWKS. Optional.
#ID_SIGNING_KEY_PREVIOUS_FILE=/run/secrets/signing-key-previous.pem

# The registered clients, see clients.example.json.
ID_CLIENTS_FILE=/etc/id/clients.json
# Secrets named by "secret_env" in that file (at least 32 chars; openssl rand -base64 32).
#ID_CLIENT_SECRET_OVERLEAF=

# Database created with schema.sql, see README.md.
ID_DB_HOST=postgres
ID_DB_PASSWORD=change-me
# Postgres superuser password, used only by the bundled docker-compose.yml to
# create the database and the limited app role. The app never uses it.
POSTGRES_SUPERUSER_PASSWORD=change-me-too

ID_REDIS_ADDR=redis:6379
# Required.
ID_REDIS_PASSWORD=change-me

# Mastodon role id -> group name sent in the groups claim. Unmapped roles send nothing.
#ID_ROLE_GROUPS={"3":"admin","2":"moderator"}

# PostgreSQL DSN of PeerTube's database, for clients with "account_link": "peertube"
# (the consent page offers to link an existing PeerTube account). See docs/account-linking.md.
#ID_LINK_PEERTUBE_DSN=

# Optional, defaults shown.
#ID_LISTEN=:8080
#ID_LANG=pt-BR
#ID_ALLOW_SILENCED=true
#ID_SESSION_TTL=2h
#ID_REFRESH_TTL=720h
#ID_DB_PORT=5432
#ID_DB_USER=id
#ID_DB_NAME=id
#ID_DB_SSLMODE=require
